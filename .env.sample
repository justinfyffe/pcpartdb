# Ads
ENABLE_ADS=false

# Website
WEBSITE_URL=http://localhost:3000
WEBSITE_EMAIL=hello@pcpartdb.com

# API
API_URL=http://localhost:3001
API_PORT=3001

# Automation
AUTOMATION_URL_DEV=http://localhost:3001
AUTOMATION_KEY_DEV=foo
AUTOMATION_URL_PROD=http://localhost:3001
AUTOMATION_KEY_PROD=foo

# Google Tag Manager
ENABLE_GTM=true
GTM_ID=id

# Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pcpartdb
POSTGRES_USER=pcpartdb
POSTGRES_PASSWORD=password

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=password

# Secrets
JWT_SECRET_RESET_PASSWORD=secret

# 3rd Party API Keys
SCRAPER_TYPE=SCRAPING_ANT # or SCRAPING_FISH
SCRAPING_ANT_API_KEY=key
SCRAPING_FISH_API_KEY=key
CLOUDFLARE_BYPASS_KEY=key

# Affiliates
NEXT_PUBLIC_AMAZON_ASSOCIATES_KEY=key-20

# Cache
ENABLE_CACHE=false
