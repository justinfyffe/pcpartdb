{
  "compilerOptions": {
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "outDir": "./dist/db/migrations",
    "skipLibCheck": true,
    "sourceMap": true,
    "module": "CommonJS",
    "moduleResolution": "node",
  },
  "include": ["./src/db/migrations/*.ts"],
}