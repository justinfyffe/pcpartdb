{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".next",
    "rootDir": "src",
    "noEmit": true,
    "module": "esnext",
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
