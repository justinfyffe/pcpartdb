{
  "name": "@pcpartdb/auto-updater",
  "description": "Auto updater service that update parts periodically. No packages should depend on this.",
  "private": "true",
  "version": "1.0.0",
  "scripts": {
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "gpu-updater": "node ./dist/gpu-updater/main.js",
    "schedule:gpu-updater": "node ./dist/gpu-updater/schedule.js"
  },
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pcpartdb.com",
  "devDependencies": {
    "@types/node": "^17.0.36",
    "@types/node-schedule": "^2.1.0",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@pcpartdb/database": "*",
    "@pcpartdb/scraper": "*",
    "@pcpartdb/shared": "*",
    "deepmerge": "^4.3.1",
    "node-schedule": "^2.1.1"
  }
}
