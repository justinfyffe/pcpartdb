generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "orderByNulls"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique(map: "access_tokens_token_hash_unique") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  user User @relation("accessTokenToUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "access_tokens_user_id_foreign")

  @@index([expiresAt], map: "access_tokens_expires_at_index")
  @@map("access_tokens")
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique(map: "api_keys_user_id_unique") @map("user_id")
  apiKey    String   @unique(map: "api_keys_api_key_unique") @map("api_key")
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  user User @relation("apiKeyToUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_keys_user_id_foreign")

  @@map("api_keys")
}

model CpuImage {
  cpuId     Int      @map("cpu_id")
  imageId   Int      @map("image_id")
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  cpu   Cpu   @relation("cpuImageToCpu", fields: [cpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cpu_images_cpu_id_foreign")
  image Image @relation("cpuImageToImage", fields: [imageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cpu_images_image_id_foreign")

  @@id([cpuId, imageId])
  @@map("cpu_images")
}

model Cpu {
  id Int @id @default(autoincrement())

  slug         String  @unique(map: "cpus_slug_unique") @db.VarChar(255)
  name         String  @db.VarChar(255)
  affiliateUrl String? @map("affiliate_url") @db.VarChar(255)

  partNumber       String?  @map("part_number")
  company          String?
  marketSegments   String[] @map("market_segments")
  launchPrice      Float?   @map("launch_price")
  releaseDate      String?  @map("release_date")
  productionStatus String?  @map("production_status")
  bundledCooler    String?  @map("bundled_cooler")

  socket      String?
  foundry     String?
  processSize Float?  @map("process_size")
  transistors Float?
  tCaseMax    Float?  @map("t_case_max")
  tjMax       Float?  @map("tj_max")

  architecture String?
  codename     String?
  generation   String?
  pciExpress   String[] @map("pci_express")
  chipsets     String[]

  memorySupport  String[] @map("memory_support")
  memoryChannels Float?   @map("memory_channels")
  hasEccMemory   Boolean? @map("has_ecc_memory")

  coresCount                Float?   @map("cores_count")
  threadsCount              Float?   @map("threads_count")
  performanceCoresCount     Float?   @map("performance_cores_count")
  efficientCoresCount       Float?   @map("efficient_cores_count")
  clock                     Float?   @map("clock")
  turboClock                Float?   @map("turbo_clock")
  performanceCoreClock      Float?   @map("performance_core_clock")
  performanceCoreTurboClock Float?   @map("performance_core_turbo_clock")
  efficientCoreClock        Float?   @map("efficient_core_clock")
  efficientCoreTurboClock   Float?   @map("efficient_core_turbo_clock")
  baseClock                 Float?   @map("base_clock")
  multiplier                Float?
  isMultiplierUnlocked      Boolean? @map("is_multiplier_unlocked")

  tdp Float? @map("tdp")
  pl1 Float? @map("pl1")
  pl2 Float? @map("pl2")
  ppt Float? @map("ppt")

  l1Cache              Float? @map("l1_cache")
  l2Cache              Float? @map("l2_cache")
  l3Cache              Float? @map("l3_cache")
  efficientCoreL1Cache Float? @map("efficient_core_l1_cache")
  efficientCoreL2Cache Float? @map("efficient_core_l2_cache")

  integratedGraphics     String?  @map("integrated_graphics")
  extensionsTechnologies String[] @map("extensions_technologies")

  performanceScore    Float? @map("performance_score")
  valueScore          Float? @map("value_score")
  cpuMarkSingleThread Float? @map("cpu_mark_single_thread")
  cpuMarkMultiThread  Float? @map("cpu_mark_multi_thread")
  geekbenchSingleCore Float? @map("geekbench_single_core")
  geekbenchMultiCore  Float? @map("geekbench_multi_core")


  // Extra Details

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Automation Data
  
  automationTimestamp DateTime @default(now()) @map("automation_timestamp")

  // Relations

  images      CpuImage[] @relation("cpuImageToCpu")
  productUpdates ProductUpdate[] @relation("productUpdateToCpu")

  @@index([automationTimestamp], name: "cpus_automation_timestamp_index")
  @@unique([company, name], name: "cpus_company_name_unique")
  @@map("cpus")
}

model GpuImage {
  gpuId     Int      @map("gpu_id")
  imageId   Int      @map("image_id")
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  gpu   Gpu   @relation("gpuImageToGpu", fields: [gpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpu_images_gpu_id_foreign")
  image Image @relation("gpuImageToImage", fields: [imageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpu_images_image_id_foreign")

  @@id([gpuId, imageId])
  @@map("gpu_images")
}

model Gpu {
  id           Int     @id @default(autoincrement())
  chipsetId    Int?    @map("chipset_id")
  slug         String  @unique(map: "gpus_slug_unique") @db.VarChar(255)
  name         String  @db.VarChar(255)
  affiliateUrl String? @map("affiliate_url") @db.VarChar(255)

  // General Info 

  partNumber       String? @map("part_number")
  company          String?
  marketSegment    String? @map("market_segment")
  launchPrice      Float?  @map("launch_price")
  releaseDate      String? @map("release_date")
  productionStatus String? @map("production_status")

  // Specs

  codename             String?
  architecture         String?
  processSize          Float?  @map("process_size")
  transistors          Float?
  memorySize           Float?  @map("memory_size")
  memoryType           String? @map("memory_type")
  memoryClock          Float?  @map("memory_clock")
  memoryInterface      Float?  @map("memory_interface")
  memoryBandwidth      Float?  @map("memory_bandwidth")
  slotWidth            Float?  @map("slot_width")
  length               Float?
  width                Float?
  height               Float?
  weight               Float?
  thermalDesignPower   Float?  @map("thermal_design_power")
  suggestedPsu         Float?  @map("suggested_psu")
  busInterface         String? @map("bus_interface")
  powerConnectors      String? @map("power_connectors")
  outputs              String?
  shaderUnitsCudaCores Float?  @map("shader_units_cuda_cores")
  computeUnitsSmCount  Float?  @map("compute_units_sm_count")
  textureMappingUnits  Float?  @map("texture_mapping_units")
  renderOutputUnits    Float?  @map("render_output_units")
  tensorCores          Float?  @map("tensor_cores")
  rayTracingCores      Float?  @map("ray_tracing_cores")
  coreClockSpeedBase   Float?  @map("core_clock_speed_base")
  coreClockSpeedBoost  Float?  @map("core_clock_speed_boost")
  l1Cache              Float?  @map("l1_cache ")
  l2Cache              Float?  @map("l2_cache")
  pixelFillRate        Float?  @map("pixel_fill_rate")
  textureFillRate      Float?  @map("texture_fill_rate")
  fp32Performance      Float?  @map("fp32_performance")
  fp64Performance      Float?  @map("fp64_performance")
  directxVersion       String? @map("directx_version")
  openClVersion        String? @map("open_cl_version")
  openGlVersion        String? @map("open_gl_version")
  shaderModelVersion   String? @map("shader_model_version")

  // Benchmarks

  performanceScore Float? @map("performance_score")
  valueScore       Float? @map("value_score")
  g3dMark          Float? @map("g3d_mark")
  g2dMark          Float? @map("g2d_mark")
  timespyGraphics  Float? @map("timespy_graphics")

  // Extra Details

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Automation Data

  automationTimestamp DateTime @default(now()) @map("cpus_automation_timestamp_index")

  // Relations

  images       GpuImage[] @relation("gpuImageToGpu")
  chipset      Gpu?  @relation("gpuToGpu", fields: [chipsetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpus_chipset_id_foreign")
  retailModels Gpu[] @relation("gpuToGpu")

  productUpdates ProductUpdate[] @relation("productUpdateToGpu")
  retailModelSources ProductSource[] @relation("productSourceToGpuChipset")

  @@index([automationTimestamp], name: "gpus_automation_timestamp_index")
  @@unique([company, name], name: "gpus_company_name_unique")
  @@map("gpus")
}

model Image {
  id         Int       @id @default(autoincrement())
  path       String    @unique(map: "images_path_unique") @db.VarChar(255)
  name       String    @db.VarChar(255)
  sourceName String?   @map("source_name") @db.VarChar(255)
  sourceUrl  String?   @map("source_url") @db.VarChar(255)
  fileSize   Int?      @map("file_size")
  height     Int?
  width      Int?
  uploadedAt DateTime? @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @ignore @db.Timestamptz(6)

  cpuImages CpuImage[] @relation("cpuImageToImage")
  gpuImages GpuImage[] @relation("gpuImageToImage")

  @@map("images")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique(map: "users_email_unique") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isStaff      Boolean?  @default(false) @map("is_staff")
  registeredAt DateTime? @default(now()) @map("registered_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  accessTokens AccessToken[] @relation("accessTokenToUser")
  apiKey       ApiKey? @relation("apiKeyToUser")

  @@map("users")
}

model ProductSource {
  // Fields

  id Int @id @default(autoincrement())

  // Key used to group sources together. Only purpose is for grouping.
  groupKey String @map("group_key")

  // Enum value to identify which type of product this ProductSource represents.
  productType String @map("product_type")

  // Enum value to identify which source provider this ProductSource represents.
  sourceKey String @map("source_key")

  // A key/id that uniquely represents the external product source.
  // Could be its id, slug, etc. Usually pulled from the URL.
  externalKey String @map("external_key")

  // The product name that the source uses.
  sourceName String @map("source_name")

  // The url to access the source.
  sourceUrl String @map("source_url")

  // Flag to indicate we've already handled this source.
  archived Boolean @default(false)

  // Identifies which GPU chipset this source is related to.
  // Only for GPU retail model sources.
  gpuChipsetId Int? @map("gpu_chipset_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations

  gpuChipset Gpu? @relation("productSourceToGpuChipset", fields: [gpuChipsetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_updates_gpu_chipset_id_foreign")

  @@index([productType, sourceName], name: "product_sources_productType_sourceName_index") 
  @@unique([productType, sourceKey, externalKey], name: "product_sources_productType_sourceKey_externalKey_unique")

  @@map("product_sources")
}

model ProductUpdate {
  // Fields

  id Int @id @default(autoincrement())

  // Enum value to identify which type of product this ProductUpdate represents.
  productType String @map("product_type")

  // Name of the product that is being created/updated.
  // Used primarily for querying.
  productName String @map("product_name")

  // Enum value representing the status of this update.
  status String

  // Description to identify what the update is doing.
  description String?
  
  // Update Data
  data Bytes?

  // General metadata for the update. Additional data about the update
  // that can be read, but should not be queried.
  metadata Json?

  // Product ids for updates.
  cpuId Int? @map("cpu_id")
  gpuId Int? @map("gpu_id")

  // Enum value that represents which type of GPU this is updating.
  // Only for GPUs, to identify if its a chipset or retail model.
  gpuProductType String? @map("gpu_product_type")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations

  cpu Cpu? @relation("productUpdateToCpu", fields: [cpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_updates_cpu_id_foreign")
  gpu Gpu? @relation("productUpdateToGpu", fields: [gpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_updates_gpu_id_foreign")

  @@index([productType, cpuId], name: "product_updates_productType_cpuId_index")
  @@index([productType, gpuId], name: "product_updates_productType_gpuId_index")
  @@index([productType, gpuProductType, status], name: "product_updates_productType_gpuProductType_status_index") 
  @@index([createdAt], name: "product_updates_createdAt_index")

  @@map("product_updates")
}

model AutomationAction {
  id Int @id @default(autoincrement())

  type        String
  status      String
  description String?
  
  data     Bytes?
  metadata Json?

  priority  Int      @default(0)
  timestamp DateTime @default(now())

  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  @@index([status, priority(sort: Desc), timestamp(sort: Asc)], name: "automation_actions_status_priority_timestamp_index") 

  @@map("automation_actions")
}
