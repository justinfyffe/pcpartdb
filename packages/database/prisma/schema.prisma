  suggestedPsuMeta Json? @map("suggested_psu_meta")

  tdpValue Float? @map("tdp_value") // aka Thermal Design Power
  tdpMeta Json? @map("tdp_meta")

  tensorCoresValue Float? @map("tensor_cores_value")
  tensorCoresMeta Json? @map("tensor_cores_meta")

  textureRateValue Float? @map("texture_rate_value")
  textureRateMeta Json? @map("texture_rate_meta")

  tmusValue Float? @map("tmus_value") // aka Texture Mapping Units
  tmusMeta Json? @map("tmus_meta")

  transistorsValue Float? @map("transistors_value")
  transistorsMeta Json? @map("transistors_meta")

  vertexRateValue Float? @map("vertex_rate_value")
  vertexRateMeta Json? @map("vertex_rate_meta")

  vertexShadersValue Float? @map("vertex_shaders_value")
  vertexShadersMeta Json? @map("vertex_shaders_meta")

  vulkanVersionValue String? @map("vulkan_version_value")
  vulkanVersionMeta Json? @map("vulkan_version_meta")

  weightValue Float? @map("weight_value")
  weightMeta Json? @map("weight_meta")

  widthValue Float? @map("width_value")
  widthMeta Json? @map("width_meta")

  // High-level Ratings
  // Value = Raw value that can be compared and sorted.
  // Meta = Metadata about the rating. E.g. formatted value to display, autoUpdate

  performanceRatingValue Float? @map("performance_rating_value")
  performanceRatingMeta Json? @map("performance_rating_meta")

  performancePerMsrpValue Float? @map("performance_per_msrp_value")
  performancePerMsrpMeta Json? @map("performance_per_msrp_meta")

  // Misc. data for the fields. This data should not be filtered on.
  metadata Json?

  // Relations
  product Product @relation("gpuFieldsToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpuFields_product_foreign")

  // Indexes
  @@unique([productId], map: "gpuFields_productId_unique")

  @@map("gpu_fields")
}