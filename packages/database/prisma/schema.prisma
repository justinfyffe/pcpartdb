  socketMeta Json? @map("socket_meta")

  tCaseMaxValue Float? @map("t_case_max_value")
  tCaseMaxMeta Json? @map("t_case_max_meta")

  tdpValue Float? @map("tdp_value") // Thermal Design Power
  tdpMeta Json? @map("tdp_meta")

  threadsValue Float? @map("threads_value")
  threadsMeta Json? @map("threads_meta")

  tjMaxValue Float? @map("tj_max_value")
  tjMaxMeta Json? @map("tj_max_meta")

  transistorsValue Float? @map("transistors_value")
  transistorsMeta Json? @map("transistors_meta")

  turboClockValue Float? @map("turbo_clock_value")
  turboClockMeta Json? @map("turbo_clock_meta")

  // High-level Ratings
  // Value = Raw value that can be compared and sorted.
  // Meta = Metadata about the rating. E.g. formatted value to display, autoUpdate

  performanceRatingValue Float? @map("performance_rating_value")
  performanceRatingMeta Json? @map("performance_rating_meta")

  performancePerMsrpValue Float? @map("performance_per_msrp_value")
  performancePerMsrpMeta Json? @map("performance_per_msrp_meta")

  // Misc. data for the fields. This data should not be filtered on.
  metadata Json?

  // Relations
  product Product? @relation("cpuFieldsToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cpuFields_product_foreign")

  // Indexes
  @@unique([productId], map: "cpuFields_productId_unique")

  @@map("cpu_fields")
}

