generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique(map: "access_tokens_token_hash_unique") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  user User @relation("accessTokenToUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "access_tokens_user_id_foreign")

  @@index([expiresAt], map: "access_tokens_expires_at_index")
  @@map("access_tokens")
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique(map: "api_keys_user_id_unique") @map("user_id")
  apiKey    String   @unique(map: "api_keys_api_key_unique") @map("api_key")
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  user User @relation("apiKeyToUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_keys_user_id_foreign")

  @@map("api_keys")
}

model Image {
  id         Int       @id @default(autoincrement())
  path       String    @unique(map: "images_path_unique") @db.VarChar(255)
  name       String    @db.VarChar(255)
  sourceName String?   @map("source_name") @db.VarChar(255)
  sourceUrl  String?   @map("source_url") @db.VarChar(255)
  fileSize   Int?      @map("file_size")
  height     Int?
  width      Int?
  uploadedAt DateTime? @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @ignore @db.Timestamptz(6)

  productImages ProductImage[] @relation("productImageToImage")
  gameListingImage Game[] @relation("gameListingImageToImage")

  @@map("images")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique(map: "users_email_unique") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isStaff      Boolean?  @default(false) @map("is_staff")
  registeredAt DateTime? @default(now()) @map("registered_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  accessTokens AccessToken[] @relation("accessTokenToUser")
  apiKey       ApiKey? @relation("apiKeyToUser")

  @@map("users")
}

//
// Product Tables
//

model Product {
  id Int @id @default(autoincrement())

  // URL slug to identify the product.
  slug String

  // Enum value to identify which type of product this Product represents.
  // E.g. CPU, GPU
  productType String @map("product_type")

  // Name of the Product.
  name String

  // Other names used with this product. Useful for generated content.
  otherNames String[] @map("other_names")

  // Company that makes the product.
  company String?

  // Text string for autocomplete search.
  // Usually a full name of the product.
  searchText String @map("search_text")

  // Affiliate URL
  affiliateUrl String? @map("affiliate_url")

  // Summary Text
  summary String? @db.Text
  summaryPublishedAt DateTime? @map("summary_published_at") @db.Timestamptz(6)
  summaryStale Boolean? @map("summary_stale") @default(false)
  enablePerformanceSummary Boolean? @map("enable_performance_summary") @default(true)

  // Misc. additional data about the product. Not meant to be filtered on.
  metadata Json?

  // Timestamp when this product was last updated automatically.
  automatedAt DateTime? @map("automated_at") @db.Timestamptz(6)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) @ignore
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  cpuFields CpuFields? @relation("cpuFieldsToProduct")
  gpuFields GpuFields? @relation("gpuFieldsToProduct")
  benchmarks ProductBenchmark[] @relation("productBenchmarkToProduct")
  gameFps ProductGameFps[] @relation("productGameFpsToProduct")
  ranks ProductRanks? @relation("productRankToProduct")
  sources ProductSource[] @relation("productSourceToProduct")
  updates ProductUpdate[] @relation("productUpdateToProduct")
  images ProductImage[] @relation("productImageToProduct")
  relatedProducts RelatedProduct[] @relation("relatedProductToProductA")
  asRelatedProducts RelatedProduct[] @relation("relatedProductToProductB")
  minimumGpuForGames Game[] @relation("gameToMinimumGpu")
  recommendedGpuForGames Game[] @relation("gameToRecommendedGpu")
  minimumCpuForGames Game[] @relation("gameToMinimumCpu")
  recommendedCpuForGames Game[] @relation("gameToRecommendedCpu")

  // Indexes
  @@unique([productType, slug], map: "products_productType_slug_unique")

  @@map("products")
}

model ProductBenchmark {
  // Primary identifier
  productId Int @map("product_id")
  benchmarkKey String @map("benchmark_key")

  // Numeric value for benchmark
  value Float?

  // Benchmark value per product's msrp_meta
  valuePerMsrp Float? @map("value_per_msrp")

  // Misc. additional data about the benchmark. Not meant to be filtered on.
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) @ignore
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6) @ignore

  // Relations
  product Product @relation("productBenchmarkToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productBenchmarks_product_foreign")
  
  // Indexes
  @@id([productId, benchmarkKey])

  @@index([benchmarkKey, value], name: "product_benchmarks_benchmarkKey_value_index")
  @@index([benchmarkKey, valuePerMsrp], name: "product_benchmarks_benchmarkKey_valuePerMsrp_index")

  @@map("product_benchmarks")
}

model ProductRanks {
  // Primary identifier
  productId Int @map("product_id")

  // Rank JSON data.
  ranks Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) @ignore
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6) @ignore

  // Relations
  product Product @relation("productRankToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productRanks_product_foreign")

  // Indexes
  @@id([productId])

  @@map("product_ranks")
}

model ProductSource {
  // Primary identifier
  productId Int @map("product_id")
  sourceKey String @map("source_key")
  
  // URL for the source
  sourceUrl String @map("source_url")

  // Misc. additional data about the source. Not meant to be filtered on.
  metadata Json?

  // Timestamp for when this source was last scraped.
  scrapedAt DateTime? @map("scraped_at") @db.Timestamptz(6)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) @ignore
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6) @ignore

  // Relations
  product Product @relation("productSourceToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productSources_product_foreign")

  // Indexes
  @@id([productId, sourceKey])
  @@unique([sourceUrl, productId], map: "productSources_sourceUrl_productId_unique")

  @@map("product_sources")
}

model ProductUpdate {
  id Int @id @default(autoincrement())

  // Enum value to identify which type of product this ProductUpdate represents.
  productType String @map("product_type")


  // Name of the product that is being created/updated.
  // Useful when there is no product id
  productName String @map("product_name")

  // Enum value representing the status of this update.
  status String

  // Description to identify what the update is doing.
  description String?
  
  // Update Data
  data Bytes?

  // General metadata for the update. Additional data about the update
  // that can be read, but should not be queried.
  metadata Json?

  // Product ids for updates.
  productId Int? @map("product_id")

  // Timestamps related to when the action started and stopped. Useful for debugging.
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations

  product Product? @relation("productUpdateToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productUpdates_product_foreign")
  
  @@index([productType, status, createdAt], name: "product_updates_type_status_createdAt_index") 

  @@map("product_updates")
}

model ProductImage {
  // IDs identifying the product and image we are joining.
  productId Int @map("product_id")
  imageId   Int @map("image_id")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  product Product @relation("productImageToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productImages_product_foreign")
  image Image @relation("productImageToImage", fields: [imageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productImages_image_foreign")

  @@id([productId, imageId])

  @@map("product_images")
}

model RelatedProduct {
  // IDs identifying the product and its relative product
  productId Int @map("product_id")
  relatedProductId Int @map("related_product_id")

  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  product Product @relation("relatedProductToProductA", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "relatedProducts_product_foreign")
  relatedProduct Product @relation("relatedProductToProductB", fields: [relatedProductId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "relatedProducts_relatedProduct_foreign")

  @@id([productId, relatedProductId])

  @@map("related_products")
}

//
// Games Tables
//

model Game {
  id Int @id @default(autoincrement())

  name String
  slug String

  nameShort String? @map("name_short")
  description String?
  publisher String?
  developer String?
  releaseDate String? @map("release_date") // YYYY-MM-DD
  affiliateUrl String? @map("affiliate_url")

  gameSettings Json? @map("game_settings")
  scraperOptions Json? @map("scraper_options")

  minimumRequirements Json? @map("minimum_requirements")
  recommendedRequirements Json? @map("recommended_requirements")

  minimumGpuId Int? @map("minimum_gpu_id")
  recommendedGpuId Int? @map("recommended_gpu_id")
  minimumCpuId Int? @map("minimum_cpu_id")
  recommendedCpuId Int? @map("recommended_cpu_id")

  listingImageId Int? @map("listing_image_id")

  metadata Json?

  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  // Relations
  minimumGpu Product? @relation("gameToMinimumGpu", fields: [minimumGpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "game_minimumGpu_foreign")
  recommendedGpu Product? @relation("gameToRecommendedGpu", fields: [recommendedGpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "game_recommendedGpu_foreign")
  minimumCpu Product? @relation("gameToMinimumCpu", fields: [minimumCpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "game_minimumCpu_foreign")
  recommendedCpu Product? @relation("gameToRecommendedCpu", fields: [recommendedCpuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "game_recommendedCpu_foreign")
  listingImage Image? @relation("gameListingImageToImage", fields: [listingImageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "game_listingImage_foreign")
  fps ProductGameFps[] @relation("productGameFpsToGame")
  
  // Indexes
  @@unique([slug], map: "games_slug_unique")

  @@map("games")
}

model ProductGameFps {
  productId Int @map("product_id")
  gameId Int @map("game_id")
  settingsPresetKey String @map("settings_preset_key")

  fps Float?
  fpsPerDollar Float? @map("fps_per_dollar")
  dollarsPerFrame Float? @map("dollars_per_frame")

  metadata Json?

  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  // Relations
  product Product @relation("productGameFpsToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gameFps_product_foreign")
  game Game @relation("productGameFpsToGame", fields: [gameId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gameFps_game_foreign")
  
  // Indexes
  @@id([productId, gameId, settingsPresetKey])

  @@map("product_game_fps")
}

//
// Automation Tables
//

model AutomationAction {
  id Int @id @default(autoincrement())

  type        String
  status      String
  description String?
  
  data     Bytes?
  metadata Json?

  priority  Int      @default(0)
  timestamp DateTime @default(now())

  createdAt DateTime  @default(now()) @map("created_at") @ignore @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @ignore @db.Timestamptz(6)

  @@index([status, priority(sort: Desc), timestamp(sort: Asc)], name: "automation_actions_status_priority_timestamp_index") 

  @@map("automation_actions")
}

model AutomationSource {
  // Fields

  id Int @id @default(autoincrement())

  // Key used to group sources together. Only purpose is for grouping.
  groupKey String @map("group_key")

  // Enum value to identify which type of product this AutomationSource represents.
  productType String @map("product_type")

  // Enum value to identify which source provider this AutomationSource represents.
  sourceKey String @map("source_key")

  // A key/id that uniquely represents the external automation source.
  // Could be its id, slug, etc. Usually pulled from the URL.
  externalKey String @map("external_key")

  // The product name that the source uses.
  sourceName String @map("source_name")

  // The url to access the source.
  sourceUrl String @map("source_url")

  // Flag to indicate we've already handled this source.
  archived Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations

  @@index([productType, archived], map: "automationSources_productType_archived_index")
  @@unique([productType, sourceKey, externalKey], map: "automationSources_productType_sourceKey_externalKey_unique")

  @@map("automation_sources")
}

//
// CPU-specific
//

model CpuFields {
  id Int @id @default(autoincrement())

  // Product that these fields belong to.
  productId Int @map("product_id")

  // Fields
  // Value = Raw value that can be compared and sorted.
  // Meta = Metadata about the field. E.g. formatted value to display, autoUpdate

  architectureValue String? @map("architecture_value")
  architectureMeta Json? @map("architecture_meta")

  baseClockValue Float? @map("base_clock_value")
  baseClockMeta Json? @map("base_clock_meta")

  bundledCoolerValue String? @map("bundled_cooler_value")
  bundledCoolerMeta Json? @map("bundled_cooler_meta")

  chipsetsValue String? @map("chipsets_value")
  chipsetsMeta Json? @map("chipsets_meta")

  clockValue Float? @map("clock_value")
  clockMeta Json? @map("clock_meta")

  codenameValue String? @map("codename_value")
  codenameMeta Json? @map("codename_meta")

  coresValue Float? @map("cores_value")
  coresMeta Json? @map("cores_meta")

  dieSizeValue Float? @map("die_size_value")
  dieSizeMeta Json? @map("die_size_meta")

  eccMemoryValue Boolean? @map("ecc_memory_value")
  eccMemoryMeta Json? @map("ecc_memory_meta")

  eCoresValue Float? @map("e_cores_value") // Efficient Cores
  eCoresMeta Json? @map("e_cores_meta")

  eCoreClockValue Float? @map("e_core_clock_value") // Efficient Core Clock
  eCoreClockMeta Json? @map("e_core_clock_meta")

  eCoreL1CacheValue Float? @map("e_core_l1_cache_value") // Efficient Core L1 Cache
  eCoreL1CacheMeta Json? @map("e_core_l1_cache_meta")

  eCoreL2CacheValue Float? @map("e_core_l2_cache_value") // Efficient Core L2 Cache
  eCoreL2CacheMeta Json? @map("e_core_l2_cache_meta")

  eCoreTurboClockValue Float? @map("e_core_turbo_clock_value") // Efficient Cores Turbo Clock
  eCoreTurboClockMeta Json? @map("e_core_turbo_clock_meta")

  extensionsTechnologiesValue String? @map("extensions_technologies_value")
  extensionsTechnologiesMeta Json? @map("extensions_technologies_meta")

  foundryValue String? @map("foundry_value")
  foundryMeta Json? @map("foundry_meta")

  generationValue String? @map("generation_value")
  generationMeta Json? @map("generation_meta")

  integratedGraphicsValue String? @map("integrated_graphics_value")
  integratedGraphicsMeta Json? @map("integrated_graphics_meta")

  l1CacheValue Float? @map("l1_cache_value")
  l1CacheMeta Json? @map("l1_cache_meta")

  l2CacheValue Float? @map("l2_cache_value")
  l2CacheMeta Json? @map("l2_cache_meta")

  l3CacheValue Float? @map("l3_cache_value")
  l3CacheMeta Json? @map("l3_cache_meta")

  marketSegmentValue String? @map("market_segment_value")
  marketSegmentMeta Json? @map("market_segment_meta")

  memoryChannelsValue Float? @map("memory_channels_value")
  memoryChannelsMeta Json? @map("memory_channels_meta")

  memorySupportValue String? @map("memory_support_value")
  memorySupportMeta Json? @map("memory_support_meta")

  msrpValue Float? @map("msrp_value")
  msrpMeta Json? @map("msrp_meta")

  multiplierValue Float? @map("multiplier_value")
  multiplierMeta Json? @map("multiplier_meta")

  multiplierUnlockedValue Boolean? @map("multiplier_unlocked_value")
  multiplierUnlockedMeta Json? @map("multiplier_unlocked_meta")

  partNumberValue String? @map("part_number_value")
  partNumberMeta Json? @map("part_number_meta")

  pciExpressValue String? @map("pci_express_value")
  pciExpressMeta Json? @map("pci_express_meta")

  pCoresValue Float? @map("p_cores_value") // Performance Cores
  pCoresMeta Json? @map("p_cores_meta")

  pCoreClockValue Float? @map("p_core_clock_value") // Performance Cores Clock
  pCoreClockMeta Json? @map("p_core_clock_meta")

  pCoreTurboClockValue Float? @map("p_core_turbo_clock_value") // Performance Cores Turbo Clock
  pCoreTurboClockMeta Json? @map("p_core_turbo_clock_meta")

  pl1Value Float? @map("pl1_value") // Power Level 1 - stock (marketed) power state
  pl1Meta Json? @map("pl1_meta")

  pl2Value Float? @map("pl2_value") // Power Level 2 - Power state when CPU uses turbo frequencies.
  pl2Meta Json? @map("pl2_meta")

  pptValue Float? @map("ppt_value") // Package Power Tracking - Measurement of power to the CPU Socket on the mobo
  pptMeta Json? @map("ppt_meta")

  processSizeValue Float?  @map("process_size_value")
  processSizeMeta Json?  @map("process_size_meta")

  productionStatusValue String? @map("production_status_value")
  productionStatusMeta Json? @map("production_status_meta")

  releaseDateValue String? @map("release_date_value")
  releaseDateMeta Json? @map("release_date_meta")

  smpValue Float? @map("smp_value") // Symmetric Multiprocessing
  smpMeta Json? @map("smp_meta")

  socketValue String? @map("socket_value")
  socketMeta Json? @map("socket_meta")

  tCaseMaxValue Float? @map("t_case_max_value")
  tCaseMaxMeta Json? @map("t_case_max_meta")

  tdpValue Float? @map("tdp_value") // Thermal Design Power
  tdpMeta Json? @map("tdp_meta")

  threadsValue Float? @map("threads_value")
  threadsMeta Json? @map("threads_meta")

  tjMaxValue Float? @map("tj_max_value")
  tjMaxMeta Json? @map("tj_max_meta")

  transistorsValue Float? @map("transistors_value")
  transistorsMeta Json? @map("transistors_meta")

  turboClockValue Float? @map("turbo_clock_value")
  turboClockMeta Json? @map("turbo_clock_meta")

  // Misc. data for the fields. This data should not be filtered on.
  metadata Json?

  // Relations
  product Product @relation("cpuFieldsToProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cpuFields_product_foreign")

  // Indexes
  @@unique([productId], map: "cpuFields_productId_unique")

  @@map("cpu_fields")
}

//
// GPU-specific
//

model GpuFields {
  id Int @id @default(autoincrement())

  // Product that these fields belong to.
  productId Int @map("product_id")

  // Fields
  // Value = Raw value that can be compared and sorted.
  // Meta = Metadata about the field. E.g. formatted value to display, autoUpdate

  // Similar to tensor cores, but for AMD
  aiAcceleratorsValue Float? @map("ai_accelerators_value")
  aiAcceleratorsMeta Json? @map("ai_accelerators_meta")

  architectureValue String? @map("architecture_value")
  architectureMeta Json? @map("architecture_meta")

  busInterfaceValue String? @map("bus_interface_value")
  busInterfaceMeta Json? @map("bus_interface_meta")

  codenameValue String? @map("codename_value")
  codenameMeta Json? @map("codename_meta")

  // Compute Units (CU) for Intel, Stream Multiprocessor (SM) for NVIDIA, Execution Unit (EU) for Intel
  computeUnitsValue Float? @map("compute_units_value")
  computeUnitsMeta Json? @map("compute_units_meta")

  // CUDA Cores for nvidia, Stream Processors (SP) for AMD, shading unit for intel, shader units
  cudaCoresValue Float? @map("cuda_cores_value")
  cudaCoresMeta Json? @map("cuda_cores_meta")

  cudaVersionValue String? @map("cuda_version_value")
  cudaVersionMeta Json? @map("cuda_version_meta")

  densityValue Float? @map("density_value")
  densityMeta Json? @map("density_meta")

  dieSizeValue Float? @map("die_size_value")
  dieSizeMeta Json? @map("die_size_meta")

  directxVersionValue String? @map("directx_version_value")
  directxVersionMeta Json? @map("directx_version_meta")

  // Compute Units (CU) for Intel, Stream Multiprocessor (SM) for NVIDIA, Execution Unit (EU) for Intel
  executionUnitsValue Float? @map("execution_units_value")
  executionUnitsMeta Json? @map("execution_units_meta")

  foundryValue String? @map("foundry_value")
  foundryMeta Json? @map("foundry_meta")

  fp16Value Float? @map("fp16_value")
  fp16Meta Json? @map("fp16_meta")

  fp32Value Float? @map("fp32_value")
  fp32Meta Json? @map("fp32_meta")

  fp64Value Float? @map("fp64_value")
  fp64Meta Json? @map("fp64_meta")

  generationValue String? @map("generation_value")
  generationMeta Json? @map("generation_meta")

  gpuCoreBaseClockValue Float? @map("gpu_core_base_clock_value")
  gpuCoreBaseClockMeta Json? @map("gpu_core_base_clock_meta")

  gpuCoreBoostClockValue Float? @map("gpu_core_boost_clock_value")
  gpuCoreBoostClockMeta Json? @map("gpu_core_boost_clock_meta")

  gpuCoreGameClockValue Float? @map("gpu_core_game_clock_value")
  gpuCoreGameClockMeta Json? @map("gpu_core_game_clock_meta")

  l1CacheValue Float? @map("l1_cache_value")
  l1CacheMeta Json? @map("l1_cache_meta")

  l2CacheValue Float? @map("l2_cache_value")
  l2CacheMeta Json? @map("l2_cache_meta")

  marketSegmentValue String? @map("market_segment_value")
  marketSegmentMeta Json? @map("market_segment_meta")

  memoryBandwidthValue Float? @map("memory_bandwidth_value")
  memoryBandwidthMeta Json? @map("memory_bandwidth_meta")

  memoryClockValue Float? @map("memory_clock_value")
  memoryClockMeta Json? @map("memory_clock_meta")

