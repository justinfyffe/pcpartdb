{
  "name": "@pcpartdb/database",
  "description": "Database library to be used with other services.",
  "private": "true",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "diff": "prisma migrate diff",
    "migrate": "prisma migrate deploy",
    "client": "prisma generate",
    "migration": "prisma migrate dev --create-only",
    "format": "prisma format",
    "pull": "prisma db pull",
    "push": "prisma db push"
  },
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pcpartdb.com",
  "devDependencies": {
    "@types/node": "^17.0.36",
    "@types/pg": "^8.6.5",
    "prisma": "^4.10.1",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@pcpartdb/shared": "*",
    "@prisma/client": "^4.10.1",
    "pg": "^8.7.3"
  }
}
