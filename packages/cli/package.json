{
  "name": "@pcpartdb/cli",
  "description": "CLI Service for PC Part DB",
  "private": "true",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "fix-data": "node ./dist/main.js fix-data",
    "gpu-updater": "node ./dist/main.js gpu-updater",
    "gpu-updater:schedule": "node ./dist/main.js gpu-updater --schedule",
    "refresh-ratings": "node ./dist/main.js refresh-ratings",
    "scrape-sources": "node ./dist/main.js scrape-sources --proxy",
    "scrape-sources:techpowerup": "node ./dist/main.js scrape-sources --source techpowerup --proxy",
    "scrape-sources:ul-benchmarks": "node ./dist/main.js scrape-sources --source ul-benchmarks --proxy",
    "scrape-sources:videocardbenchmarks": "node ./dist/main.js scrape-sources --source videocardbenchmarks",
    "scrape-data": "node ./dist/main.js scrape-data --proxy"
  },
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pcpartdb.com",
  "devDependencies": {
    "@types/node": "^17.0.36",
    "@types/node-schedule": "^2.1.0",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@pcpartdb/database": "*",
    "@pcpartdb/scraper": "*",
    "@pcpartdb/shared": "*",
    "commander": "^10.0.0",
    "date-fns": "^2.28.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.0.3",
    "node-schedule": "^2.1.1"
  }
}
