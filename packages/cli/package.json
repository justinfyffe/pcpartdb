{
  "name": "@pcpartdb/cli",
  "description": "CLI Service for PC Part DB",
  "private": "true",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "watch": "tsc --watch",
    "post-deployment": "node ./dist/main.js post-deployment",
    "scratch-pad": "node ./dist/main.js scratch-pad",
    "automation": "node ./dist/main.js automation",
    "automation:dev": "node ./dist/main.js automation --env=dev",
    "automation:prod": "node ./dist/main.js automation --env=prod",
    "automation:continuous": "node ./dist/main.js automation --continuous",
    "automation:continuous:dev": "node ./dist/main.js automation --continuous --env=dev",
    "automation:continuous:prod": "node ./dist/main.js automation --continuous --env=prod"
  },
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pcpartdb.com",
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/node-schedule": "^2.1.0",
    "@types/tar": "^6.1.5",
    "@types/xml": "^1.0.8",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@pcpartdb/database": "*",
    "@pcpartdb/scraper": "*",
    "@pcpartdb/shared": "*",
    "axios": "^1.6.2",
    "commander": "^10.0.0",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.3",
    "fast-json-patch": "^3.1.1",
    "form-data": "^4.0.0",
    "node-schedule": "^2.1.1",
    "tar": "^6.1.15",
    "xml": "^1.0.1"
  }
}
