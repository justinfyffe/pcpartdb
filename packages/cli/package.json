{
  "name": "@pcpartdb/cli",
  "description": "CLI Service for PC Part DB",
  "private": "true",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "scratch-pad": "node ./dist/main.js scratch-pad",
    "gpu-updater": "node ./dist/main.js gpu-updater",
    "gpu-updater:schedule": "node ./dist/main.js gpu-updater --schedule",
    "refresh-ratings": "node ./dist/main.js refresh-ratings",
    "scrape-sources": "node ./dist/main.js scrape-sources",
    "scrape-sources:cpu": "node ./dist/main.js scrape-sources --product cpu",
    "scrape-sources:gpu": "node ./dist/main.js scrape-sources --product gpu",
    "scrape-sources:techpowerup": "node ./dist/main.js scrape-sources --source techpowerup",
    "scrape-sources:ul-benchmarks": "node ./dist/main.js scrape-sources --source ul-benchmarks",
    "scrape-sources:videocardbenchmarks": "node ./dist/main.js scrape-sources --source videocardbenchmarks",
    "scrape-data": "node ./dist/main.js scrape-data",
    "scrape-data:cpu": "node ./dist/main.js scrape-data --product cpu",
    "scrape-data:gpu": "node ./dist/main.js scrape-data --product gpu",
    "scrape-retail-models:dataOnly": "node ./dist/main.js scrape-retail-models --dataOnly",
    "scrape-retail-models:sourcesOnly": "node ./dist/main.js scrape-retail-models --sourcesOnly",
    "sitemap-updater": "node ./dist/main.js sitemap-updater",
    "sitemap-updater:schedule": "node ./dist/main.js sitemap-updater --schedule"
  },
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pcpartdb.com",
  "devDependencies": {
    "@types/node": "^17.0.36",
    "@types/node-schedule": "^2.1.0",
    "@types/xml": "^1.0.8",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@pcpartdb/database": "*",
    "@pcpartdb/scraper": "*",
    "@pcpartdb/shared": "*",
    "axios": "^0.27.2",
    "commander": "^10.0.0",
    "date-fns": "^2.28.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.0.3",
    "fast-json-patch": "^3.1.1",
    "node-schedule": "^2.1.1",
    "xml": "^1.0.1"
  }
}
