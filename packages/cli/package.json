{
  "name": "@pcpartdb/cli",
  "description": "CLI Service for PC Part DB",
  "private": "true",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf ./dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "scrape:sources": "node ./dist/index.js scrape sources --proxy",
    "scrape:sources:techpowerup": "node ./dist/index.js scrape sources --source techpowerup --proxy",
    "scrape:sources:ul-benchmarks": "node ./dist/index.js scrape sources --source ul-benchmarks --proxy",
    "scrape:sources:videocardbenchmarks": "node ./dist/index.js scrape sources --source videocardbenchmarks",
    "scrape:data": "node ./dist/index.js scrape data --proxy"
  },
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pcpartdb.com",
  "devDependencies": {
    "@types/node": "^17.0.36",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@pcpartdb/scraper": "*",
    "@pcpartdb/shared": "*",
    "commander": "^10.0.0",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.3"
  }
}
