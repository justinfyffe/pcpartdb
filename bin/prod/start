#!/bin/bash
DIRECTORY=$(cd `dirname $0` && pwd)
cd $DIRECTORY/../../

pm2 stop all

NODE_ENV=production pm2 start npm --node-args="--gc_interval=100" --name "pcpartdb-api" -- run "prod:api"
NODE_ENV=production pm2 start npm --node-args="--gc_interval=100" --name "pcpartdb-website" -- run "prod:website"
NODE_ENV=production pm2 start npm --node-args="--gc_interval=100" --name "pcpartdb-gpu-updater" -- run "prod:gpu-updater"
NODE_ENV=production pm2 start npm --node-args="--gc_interval=100" --name "pcpartdb-sitemap-updater" -- run "prod:sitemap-updater"
