{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["esnext"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "outDir": "./dist",
    "paths": {
      "@pcpartdb/database/*": ["packages/database/src/*"],
      "@pcpartdb/database": ["packages/database/src"],
      "@pcpartdb/website/*": ["packages/website/src/*"],
    },
    "pretty": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": false,
    "target": "es5"
  },
  "references": [
    { "path": "packages/database/tsconfig.json"},
    { "path": "packages/scraper/tsconfig.json" },
    { "path": "packages/website/tsconfig.json" },
  ],
  "include": [],
  "exclude": ["dist", "node_modules", "*.d.ts"]
}
