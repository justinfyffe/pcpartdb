    "next": "^13.0.1",
    "nodemailer": "^6.7.7",
    "npm": "^8.13.2",
    "objection": "^3.0.1",
    "pg": "^8.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.31.3",
    "react-markdown": "^8.0.3",
