    "@hapi/joi": "^17.1.1",
    "@nestjs/common": "^8.4.5",
    "@nestjs/core": "^8.4.5",
    "@nestjs/platform-express": "^8.4.5",
    "axios": "^0.27.2",
    "dotenv": "^16.0.1",
