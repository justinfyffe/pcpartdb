    "clean:tools": "rm -rf dist/tools",
    "build": "npm run build:app && npm run build:tools",
    "build:app": "next build",
    "build:tools": "tsc --project tsconfig.tools.json",
    "dev": "next dev",
    "start": "next start -p 3010",
