{
  "name": "pcpartsdb",
  "version": "1.0.0",
  "description": "Website for viewing and comparing pc specs in an easy format",
  "main": "index.js",
  "scripts": {
    "clean": "npm run clean:app & npm run clean:migrations",
    "clean:app": "rm -rf .next",
    "clean:migrations": "rm -rf dist/db",
    "build": "npm run build:app & npm run build:migrations",
    "build:app": "next build",
    "build:migrations": "tsc --project tsconfig.migrations.json",
    "dev": "next dev",
    "start": "next start",
    "db:migrate": "npm run clean:migrations && npm run build:migrations && knex migrate:latest --knexfile=./knexfile.dist.js",
    "db:migrate:make": "knex migrate:make -x ts --knexfile=./knexfile.src.js",
    "db:rollback": "knex migrate:rollback --knexfile=./knexfile.dist.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinfyffe/easypcspecs.git"
  },
  "keywords": [
    "easy pc",
    "easy computer",
    "simple pc",
    "simple computer",
    "easy computer specs",
    "simple pc specs",
    "simple computer specs"
  ],
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/justinfyffe/easypcspecs/issues"
  },
  "homepage": "https://pcpartsdb.com",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/big.js": "^6.1.6",
    "@types/classnames": "^2.3.1",
    "@types/express": "^4.17.13",
    "@types/hapi__joi": "^17.1.8",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^1.4.7",
    "@types/multer-s3": "^3.0.0",
    "@types/node": "^17.0.36",
    "@types/nodemailer": "^6.4.4",
    "@types/pg": "^8.6.5",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.26.0",
    "@typescript-eslint/parser": "^5.26.0",
    "autoprefixer": "^10.4.7",
    "eslint": "^8.16.0",
    "eslint-config-next": "^13.0.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "postcss": "^8.4.14",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "tailwindcss": "^3.0.24",
    "ts-node": "^10.8.0",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.135.0",
    "@hapi/joi": "^17.1.1",
    "@heroicons/react": "^2.0.12",
    "@hookform/resolvers": "^2.9.5",
    "@next/bundle-analyzer": "^13.0.1",
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "big.js": "^6.2.1",
    "cheerio": "^1.0.0-rc.12",
    "classnames": "^2.3.1",
    "cookies-next": "^2.1.1",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.1",
    "install": "^0.13.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^2.1.0",
    "multer": "^1.4.5-lts.1",
