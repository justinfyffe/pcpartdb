    "easy computer",
    "simple pc",
    "simple computer",
    "easy computer specs",
    "simple pc specs",
    "simple computer specs"
  ],
  "author": "Justin Fyffe <test@example.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/justinfyffe/easypcspecs/issues"
  },
  "homepage": "https://easypcspecs.com",
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/hapi__joi": "^17.1.8",
    "@types/node": "^17.0.36",
    "@types/pg": "^8.6.5",
    "@types/react": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.26.0",
    "@typescript-eslint/parser": "^5.26.0",
    "eslint": "^8.16.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "ts-node": "^10.8.0",
    "typescript": "^4.7.2"
  },
