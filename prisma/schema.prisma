generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model access_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique(map: "access_tokens_token_hash_unique") @db.VarChar(255)
  expires_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6) @updatedAt
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "access_tokens_user_id_foreign")

  @@index([expires_at], map: "access_tokens_expires_at_index")
}

model gpu_benchmarks {
  gpu_id            Int      @id
  performance_score Json?
  value_score       Json?
  g3d_mark          Json?
  g2d_mark          Json?
  timespy_graphics  Json?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6) @updatedAt
  gpus              gpus     @relation(fields: [gpu_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpu_benchmarks_gpu_id_foreign")
}

model gpu_images {
  gpu_id     Int
  image_id   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6) @updatedAt
  gpus       gpus     @relation(fields: [gpu_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpu_images_gpu_id_foreign")
  images     images   @relation(fields: [image_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpu_images_image_id_foreign")

  @@id([gpu_id, image_id])
}

model gpu_specs {
  gpu_id                  Int      @id
  company                 Json?
  market_segment          Json?
  launch_price            Json?
  release_date            Json?
  codename                Json?
  architecture            Json?
  process_size            Json?
  transistors             Json?
  memory_size             Json?
  memory_type             Json?
  memory_clock            Json?
  memory_interface        Json?
  memory_bandwidth        Json?
  slot_width              Json?
  length                  Json?
  width                   Json?
  height                  Json?
  weight                  Json?
  thermal_design_power    Json?
  suggested_psu           Json?
  bus_interface           Json?
  power_connectors        Json?
  outputs                 Json?
  shader_units_cuda_cores Json?
  texture_mapping_units   Json?
  render_output_units     Json?
  tensor_cores            Json?
  ray_tracing_cores       Json?
  core_clock_speed_base   Json?
  core_clock_speed_boost  Json?
  l1_cache                Json?
  l2_cache                Json?
  pixel_fill_rate         Json?
  texture_fill_rate       Json?
  fp32_performance        Json?
  fp64_performance        Json?
  directx_version         Json?
  open_cl_version         Json?
  open_gl_version         Json?
  shader_model_version    Json?
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6) @updatedAt
  gpus                    gpus     @relation(fields: [gpu_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpu_specs_gpu_id_foreign")
}

model gpus {
  id             Int             @id @default(autoincrement())
  parent_id      Int?
  slug           String          @unique(map: "gpus_slug_unique") @db.VarChar(255)
  name           String          @unique(map: "gpus_name_unique") @db.VarChar(255)
  affiliate_url  String?         @db.VarChar(255)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6) @updatedAt
  gpu_benchmarks gpu_benchmarks?
  gpu_images     gpu_images[]
  gpu_specs      gpu_specs?
  gpus           gpus?           @relation("gpusTogpus", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gpus_parent_id_foreign")
  other_gpus     gpus[]          @relation("gpusTogpus")
}

model images {
  id          Int          @id @default(autoincrement())
  path        String       @unique(map: "images_path_unique") @db.VarChar(255)
  name        String       @db.VarChar(255)
  source_name String?      @db.VarChar(255)
  source_url  String?      @db.VarChar(255)
  file_size   Int?
  height      Int?
  width       Int?
  uploaded_at DateTime?    @default(now()) @db.Timestamptz(6)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  gpu_images  gpu_images[]
}

model users {
  id            Int             @id @default(autoincrement())
  email         String          @unique(map: "users_email_unique") @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  is_staff      Boolean?        @default(false)
  registered_at DateTime?       @default(now()) @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6) @updatedAt
  access_tokens access_tokens[]
}
