{
  "compilerOptions": {
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@scrapers/*": ["scrapers/*"],
      "@shared/*": ["shared/*"],
    },
    "baseUrl": "./src",
    "target": "esnext",
    
  },
  "include": ["./src/tools/**/*.ts"],
}